[Unit]
Description=g1d web debug / control UI (http://<robot>:8080)
After=network-online.target g1d-guard.service
Wants=network-online.target

[Service]
Type=simple
User=unitree
EnvironmentFile=/opt/g1d_ws/deploy/g1d.env
WorkingDirectory=/opt/g1d_ws
ExecStart=/usr/bin/python3 -m g1d_web --config ${G1D_CONFIG}
Restart=on-failure
RestartSec=2
CPUAffinity=7
Nice=5
KillSignal=SIGINT
TimeoutStopSec=3

[Install]
WantedBy=multi-user.target
